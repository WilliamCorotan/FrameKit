{
  "name": "@framekit/nitro",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --root ../.. packages/nitro/src/index.test.ts packages/nitro/src/mfa.test.ts packages/nitro/src/oidc-mfa.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build",
    "test:browser": "pnpm --filter @framekit/nitro... build && playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@framekit/auth": "workspace:*",
    "@framekit/core": "workspace:*",
    "@framekit/openapi": "workspace:*",
    "@framekit/runtime": "workspace:*",
    "h3": "2.0.1-rc.22"
  },
  "description": "Nitro integration for Framekit runtimes.",
  "files": [
    "dist",
    "src/contracts.ts",
    "src/index.ts",
    "src/production-policy.ts",
    "src/request-security-policy.ts",
    "src/route-dispatcher.ts",
    "src/route-matchers.ts",
    "src/telemetry.ts"
  ],
  "engines": {
    "node": ">=22 <26"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "keywords": [
    "framekit",
    "typescript",
    "meta-framework",
    "nitro"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/WilliamCorotan/FrameKit.git",
    "directory": "packages/nitro"
  },
  "bugs": {
    "url": "https://github.com/WilliamCorotan/FrameKit/issues"
  },
  "homepage": "https://github.com/WilliamCorotan/FrameKit#readme"
}
