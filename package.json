{
  "name": "framekit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "description": "A Nitro-powered TypeScript meta-framework inspired by Frappe.",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @framekit/example-crm dev",
    "dev:desk": "pnpm --filter @framekit/desk dev",
    "dev:frontend:react": "pnpm --filter @framekit/example-frontend-react dev",
    "dev:frontend:vue": "pnpm --filter @framekit/example-frontend-vue dev",
    "dev:frontend:svelte": "pnpm --filter @framekit/example-frontend-svelte dev",
    "dev:frontend:solid": "pnpm --filter @framekit/example-frontend-solid dev",
    "dev:frontend:vanilla": "pnpm --filter @framekit/example-frontend-vanilla dev",
    "build:frontends": "pnpm --filter @framekit/sdk build && pnpm --filter './examples/frontends/*' build",
    "lint": "tsc -p tsconfig.check.json --noEmit && pnpm typecheck:frontends",
    "release:candidate": "node scripts/release-candidate.mjs",
    "release:candidate:check": "node scripts/release-candidate.mjs --check",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:services:coverage": "vitest run --config vitest.services.config.ts --coverage",
    "audit:dependencies": "pnpm audit --audit-level low",
    "test:desk:browser": "pnpm --filter @framekit/desk test:browser",
    "test:desk:fullstack": "pnpm --filter @framekit/desk test:browser:fullstack",
    "test:frontends:browser": "playwright test --config examples/frontends/playwright.config.ts",
    "test:services": "pnpm --filter @framekit/db test:integration && pnpm --filter @framekit/jobs test:integration",
    "verify:package-exports": "node scripts/verify-package-exports.mjs",
    "verify:standalone": "node scripts/verify-standalone.mjs",
    "smoke:crm:built": "pnpm --filter @framekit/example-crm smoke:built",
    "test:smoke:crm:built": "pnpm --filter @framekit/example-crm test:smoke-built",
    "typecheck": "pnpm -r --if-present typecheck",
    "typecheck:frontends": "pnpm --filter './examples/frontends/*' typecheck",
    "verify:frontends": "pnpm typecheck:frontends && pnpm build:frontends",
    "verify:frontends:standalone": "node scripts/verify-frontend-templates.mjs",
    "audit:all": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  }
}
