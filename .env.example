NODE_ENV=development
PORT=3000
# Required: explicit PostgreSQL URL; no default database is selected.
DATABASE_URL=
# Required only when using the Compose PostgreSQL service.
FRAMEKIT_POSTGRES_PASSWORD=
REDIS_URL=redis://localhost:6379
VITE_FRAMEKIT_API_URL=http://localhost:3000
FRAMEKIT_ALLOWED_ORIGINS=http://localhost:5173
FRAMEKIT_TRUST_PROXY=false
FRAMEKIT_COOKIE_SAME_SITE=lax
FRAMEKIT_AUTH_SECRET=development-secret-change-me
FRAMEKIT_ADMIN_EMAIL=admin@example.com
FRAMEKIT_ADMIN_PASSWORD=admin12345
